{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker:cleanup",
      "type": "shell",
      "command": "docker compose down", // No -v flag means volumes stay safe!
      "problemMatcher": []
    },
    {
      "label": "docker:dev:up",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
      "isBackground": false,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "logs:backend",
      "type": "shell",
      "command": "docker compose logs -f --tail 100 backend",
      "presentation": {
        "panel": "dedicated",
        "group": "logs",
        "clear": true,
        "focus": false,
        "close": false
      }
    },
    {
      "label": "logs:frontend",
      "type": "shell",
      "command": "docker compose logs -f --tail 100 frontend",
      "presentation": {
        "panel": "dedicated",
        "group": "logs",
        "clear": true,
        "focus": true,
        "close": false
      }
    },
    {
      "label": "logs:all",
      "dependsOn": ["logs:backend", "logs:frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "dev:all",
      "dependsOn": ["docker:dev:up", "logs:all"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
