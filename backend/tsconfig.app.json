{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext", // This is the most important for .js extensions
    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@viernulvier/shared/*": ["../shared/src/*"] // Tell the linter where shared is
    },
    "preserveSymlinks": true
  },
  "include": ["src/**/*.ts", "test/**/*"]
}
